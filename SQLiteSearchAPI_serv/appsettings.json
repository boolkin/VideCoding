{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:5000"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Error"
    }
  },
  "Limits": {
    "MaxSearchLimit": 100,
    "MaxResponseSizeBytes": 5242880
  },
  "Databases": [
    {
      "file": "VFD_errors.db",
      "tables": [
        { "name": "Mitsu_FR_A800_Ru", "Columns": ["id", "Code", "Name", "Description", "Object", "Action"] },
        { "name": "ESQ_760", "Columns": ["id", "Code", "Name", "Description", "Action"] },
        { "name": "Sie_G120_En", "Columns": ["id", "Code", "Cause", "Action"] },
        { "name": "Sie_G120_Ru", "Columns": ["id", "Code", "Cause", "Action"] }
      ]
    },
    {
      "file": "reports.db",
      "tables": [
        { "name": "Reports", "Columns": ["Id", "FilePath", "ReportText", "FileModifiedAt"] },
        { "name": "FailedFiles", "Columns": ["Id", "FilePath", "FullDocumentText", "FileModifiedAt"] }
      ]
    },
    {
      "file": "instructions.db",
      "tables": [
        { "name": "FailedFiles", "Columns": ["Id", "FilePath", "FullDocumentText", "FileModifiedAt"] }
      ]
    }
  ]
}