{
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "CollectorSettings": {
    "Endpoint": "http://127.0.0.1:8085/api/tags", 
    "IntervalSeconds": 2,
    "DatabaseName": "AggregatData.db",
    "TableName": "Metrics",
    "Signals": [
      { "JsonAddr": "storage.bool.reg01", "Alias": "Reg01" },
      { "JsonAddr": "numeric.random.float", "Alias": "Temperature" },
      { "JsonAddr": "numeric.sin.int8", "Alias": "Power" }
    ]
  }
}
